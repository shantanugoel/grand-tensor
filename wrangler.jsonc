{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grand-tensor-leaderboard",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "leaderboard.grandtensor.shantanugoel.com",
      "custom_domain": true
    }
  ],
  // Production values. Anything permitting a local origin or a locally solved
  // Turnstile token belongs in the ignored .dev.vars (see .dev.vars.example),
  // which Wrangler layers over these for `leaderboard:dev` only — the Turnstile
  // hostname is the sole check a non-browser caller cannot forge, so shipping
  // localhost in it would let anyone serving the app submit to the real board.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEHyFhblcq5hQ2vP",
    "TURNSTILE_HOSTNAMES": "grandtensor.shantanugoel.com",
    "CORS_ORIGINS": "https://grandtensor.shantanugoel.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grand-tensor-leaderboard",
      "database_id": "45fbb797-ebef-4042-8a90-c64e3df4e7b3",
      "migrations_dir": "worker/migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
