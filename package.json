{
  "name": "grand-tensor",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "tsc --noEmit && rm -rf dist && bun build ./index.html --outdir=dist --minify --public-path=./ && touch dist/.nojekyll",
    "preview": "bun run preview.ts",
    "test": "bun test",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "leaderboard:dev": "wrangler dev",
    "leaderboard:deploy": "wrangler deploy",
    "leaderboard:migrate:local": "wrangler d1 migrations apply grand-tensor-leaderboard --local",
    "leaderboard:migrate:remote": "wrangler d1 migrations apply grand-tensor-leaderboard --remote"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/bun": "^1.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.119.0"
  }
}
