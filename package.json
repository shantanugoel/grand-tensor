{
  "name": "grand-tensor",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "build": "bun run build.ts",
    "preview": "bun run preview.ts",
    "test": "bun test",
    "eval": "bun run src/eval/run.ts",
    "harness": "bun run harness/server.ts",
    "typecheck:worker": "tsc -p worker/tsconfig.json",
    "cloudflare:check": "bun run typecheck:worker && bun test && bun run build",
    "cloudflare:dev": "bun run build && wrangler dev",
    "deploy": "bun run deploy.ts",
    "upload:preview": "bun run deploy.ts --preview",
    "leaderboard:dev": "wrangler dev",
    "leaderboard:migrate:local": "wrangler d1 migrations apply grand-tensor-leaderboard --local",
    "leaderboard:migrate:remote": "wrangler d1 migrations apply grand-tensor-leaderboard --remote"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "stockfish": "18.0.8",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/bun": "^1.3.0",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.2",
    "wrangler": "^4.119.0"
  }
}
